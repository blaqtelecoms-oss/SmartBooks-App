{
  "name": "AllocationRule",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company ID"
    },
    "match_field": {
      "type": "string",
      "enum": [
        "description",
        "reference",
        "supplier_name",
        "amount"
      ],
      "description": "Field to match"
    },
    "match_type": {
      "type": "string",
      "enum": [
        "contains",
        "exact",
        "starts_with",
        "range"
      ],
      "description": "Match type"
    },
    "match_value": {
      "type": "string",
      "description": "Value to match"
    },
    "account_id": {
      "type": "string",
      "description": "Target account ID"
    },
    "account_name": {
      "type": "string",
      "description": "Target account name"
    },
    "vat_applicable": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "times_applied": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "ai_learned"
      ],
      "default": "manual"
    }
  },
  "required": [
    "company_id",
    "match_field",
    "match_type",
    "match_value",
    "account_id"
  ]
}
{
  "name": "TaxReturn",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "VAT201",
        "ITR12",
        "ITR14",
        "EMP201",
        "IRP5"
      ],
      "description": "Tax return type"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "calculated",
        "reviewed",
        "submitted",
        "filed"
      ],
      "default": "draft"
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "data": {
      "type": "string",
      "description": "JSON string of calculated return data"
    },
    "notes": {
      "type": "string"
    },
    "filed_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "company_id",
    "type",
    "period_start",
    "period_end"
  ]
}
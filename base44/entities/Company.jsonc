{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "registration_number": {
      "type": "string",
      "description": "CIPC registration number"
    },
    "vat_number": {
      "type": "string",
      "description": "VAT registration number"
    },
    "paye_number": {
      "type": "string",
      "description": "PAYE reference number"
    },
    "uif_number": {
      "type": "string",
      "description": "UIF reference number"
    },
    "sdl_number": {
      "type": "string",
      "description": "SDL reference number"
    },
    "tax_number": {
      "type": "string",
      "description": "Income tax number"
    },
    "financial_year_end": {
      "type": "string",
      "enum": [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December"
      ],
      "description": "Financial year end month"
    },
    "industry": {
      "type": "string",
      "description": "Industry sector"
    },
    "address": {
      "type": "string",
      "description": "Business address"
    },
    "contact_email": {
      "type": "string",
      "description": "Primary contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Primary contact phone"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "owner_id": {
      "type": "string",
      "description": "User ID of the company owner"
    }
  },
  "required": [
    "name"
  ]
}